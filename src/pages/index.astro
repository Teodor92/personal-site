---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../data/site';
import { roles } from '../data/cv';
import { personSchema } from '../data/schema';
// Rendered at 96px; astro:assets emits webp at 1x/2x instead of the 1536px
// original (which stays in public/ for the og:image and JSON-LD Person schema).
import avatar from '../assets/bio-photo.jpg';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const highlights = roles.filter((r) => r.highlight);
---

<Base
  title="Teodor Kurtev · Senior Applied AI Software Engineer"
  image="/og/index.png"
  schema={personSchema}
>
  <section class="hero">
    <Image
      src={avatar}
      alt={site.name}
      width={96}
      height={96}
      densities={[1, 2]}
      format="webp"
      loading="eager"
    />
    <div>
      <h1>{site.name}</h1>
      <p class="role">{site.role}</p>
      <p class="pitch">{site.pitch}</p>
      <SocialLinks />
    </div>
  </section>

  <section>
    <h2>Recent roles</h2>
    <ul class="highlights fill-cycle">
      {
        highlights.map((r) => (
          <li>
            <strong>
              {r.title} · <a href={r.url}>{r.company}</a>
            </strong>
            <span class="meta"> · {r.period}</span>
            <p class="muted">{r.bullets[0]}</p>
          </li>
        ))
      }
    </ul>
    <p><a href="/cv/">Full CV →</a></p>
  </section>

  <section>
    <h2>Recent writing</h2>
    <PostList posts={posts} />
    <p class="all-posts"><a href="/blog/">All posts →</a></p>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
    margin-bottom: 3.5rem;
  }

  /* Photo as a tilted polaroid-ish tile with a pink hard shadow. */
  .hero img {
    border-radius: 14px;
    flex-shrink: 0;
    border: var(--bw) solid var(--ink);
    box-shadow: 6px 6px 0 var(--pink);
    transform: rotate(-3deg);
  }

  .hero h1 {
    margin-bottom: 0.15rem;
  }

  /* Sticker-style role badge. */
  .role {
    display: inline-block;
    background: var(--cyan);
    color: var(--on-fill);
    font-weight: 600;
    font-size: var(--text-sm);
    border: 2px solid var(--ink);
    border-radius: 6px;
    box-shadow: 3px 3px 0 var(--ink);
    padding: 0.2rem 0.65rem;
    margin: 0.5rem 0 1rem;
    transform: rotate(-1deg);
  }

  .pitch {
    color: var(--fg-muted);
    max-width: 36rem;
  }

  section + section {
    margin-top: 3rem;
  }

  section h2 {
    font-size: var(--text-lg);
    margin-top: 0;
    margin-bottom: 1rem;
  }

  /* Section headings as yellow label tabs instead of the prose marker. */
  section h2 {
    display: inline-block;
    background: var(--yellow);
    color: var(--on-fill);
    border: 2px solid var(--ink);
    border-radius: 6px;
    box-shadow: 3px 3px 0 var(--ink);
    padding: 0.1rem 0.6rem;
    text-decoration: none;
  }

  .highlights {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }

  /* Each role hangs off a thick bar in its own bright. */
  .highlights li {
    border-left: 6px solid var(--fill);
    padding-left: 1rem;
  }

  .highlights p {
    margin: 0.2rem 0 0;
  }

  .all-posts {
    margin-top: 1.25rem;
  }

  @media (max-width: 540px) {
    .hero {
      flex-direction: column;
      gap: 1.25rem;
    }
  }
</style>
