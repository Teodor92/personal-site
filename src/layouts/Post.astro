---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Comments from '../components/Comments.astro';
import { site } from '../data/site';

interface Props {
  post: CollectionEntry<'blog'>;
  minutesRead?: string;
}

const { post, minutesRead } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(heroImage && { image: new URL(heroImage.src, site.url).toString() }),
  author: { '@type': 'Person', name: site.name, url: site.url },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, site.url).toString(),
};
---

<Base
  title={`${title} | Teodor Kurtev`}
  description={description}
  image={`/og/blog/${post.id}.png`}
  article
  schema={schema}
>
  <div id="progress-bar" aria-hidden="true"></div>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {minutesRead && <span> · {minutesRead}</span>}
      </p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <a href={`/tags/${tag.toLowerCase()}/`}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    <slot />
  </article>
  <Comments />
</Base>

<style>
  article > header {
    margin-bottom: 2.5rem;
  }

  .meta {
    color: var(--fg-faint);
    font-size: var(--text-sm);
    margin: 0.75rem 0 0;
  }

  .tags {
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags li a {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--fg-muted);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.65rem;
    transition: border-color 0.15s ease;
  }

  .tags li a:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
</style>
