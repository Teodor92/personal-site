---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

interface Props {
  // Match <main>'s width so the header's left edge lines up with the content.
  wide?: boolean;
}

const { wide = false } = Astro.props;

// CV first: it's what most visitors who use the nav are looking for.
const nav = [
  { label: 'CV', href: '/cv/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Uses', href: '/uses/' },
  { label: 'Now', href: '/now/' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header>
  <nav aria-label="Main" class:list={[{ wide }]}>
    <a class="home" href="/">{site.name}</a>
    <div class="links">
      {
        nav.map(({ label, href }) => (
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  header {
    background: var(--yellow);
    border-bottom: var(--bw) solid var(--ink);
  }

  /* In dark the bar is a dark slab; the brights stay in the accents. */
  :global([data-theme='dark']) header {
    background: var(--bg-raised);
  }

  nav {
    width: min(100% - 2.5rem, var(--content-width));
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.1rem;
  }

  nav.wide {
    width: min(100% - 2.5rem, var(--wide-width));
  }

  .home {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--fg);
    letter-spacing: -0.02em;
  }

  .home:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    color: var(--fg);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .links a {
    color: var(--fg);
    font-size: var(--text-sm);
    font-weight: 600;
    /* Grows the tap target to ~40px; the negative margin cancels the padding in
       the flex layout, so the header keeps its height. */
    padding-block: 0.5rem;
    margin-block: -0.5rem;
  }

  .links a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }

  /* The current page needs a cue that survives without colour. */
  .links a[aria-current='page'] {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--ink);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }

  /* Pink cue for the current page in dark, where the bar isn't yellow. */
  :global([data-theme='dark']) .links a[aria-current='page'] {
    text-decoration-color: var(--pink);
  }

  /* Touch screens: 44px-tall targets with a little extra width, without
     changing the bar's height. */
  @media (pointer: coarse) {
    .links a {
      padding: 0.7rem 0.3rem;
      margin: -0.7rem -0.3rem;
    }
  }

  @media (max-width: 480px) {
    .links {
      gap: 0.9rem;
    }

    .home {
      font-size: var(--text-base);
      line-height: 1.2;
    }
  }
</style>
