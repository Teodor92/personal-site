---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

interface Props {
  // Match <main>'s width so the header's left edge lines up with the content.
  size?: 'content' | 'wide' | 'home';
}

const { size = 'content' } = Astro.props;

// CV first: it's what most visitors who use the nav are looking for.
const nav = [
  { label: 'CV', href: '/cv/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Uses', href: '/uses/' },
  { label: 'Now', href: '/now/' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header>
  <nav aria-label="Main" class={size}>
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true">TK</span>
      <span class="name">{site.name}</span>
    </a>
    <div class="links">
      {
        nav.map(({ label, href }) => (
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  header {
    background: var(--bg);
    border-bottom: var(--bw) solid var(--ink);
  }

  nav {
    width: min(100% - 2.5rem, var(--content-width));
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
  }

  nav.wide {
    width: min(100% - 2.5rem, var(--wide-width));
  }

  nav.home {
    width: min(100% - 2.5rem, var(--home-width));
  }

  /* Brand: a yellow TK plate (the AI colour is his lead) beside the name. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-lg);
    color: var(--fg);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    background: var(--ai);
    color: var(--on-fill);
    border: var(--bw) solid var(--ink);
    border-radius: 6px;
    box-shadow: 3px 3px 0 var(--ink);
    font-size: 0.9rem;
    letter-spacing: -0.03em;
    transition:
      transform 0.08s ease-out,
      box-shadow 0.08s ease-out;
  }

  .brand:hover {
    color: var(--fg);
    text-decoration: none;
  }

  .brand:hover .mark {
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0 var(--ink);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Nav items are outlined pills on hover; the current page wears the outline
     and an ink underline bar so the cue never depends on colour. */
  .links a {
    color: var(--fg);
    font-weight: 700;
    font-size: var(--text-sm);
    padding: 0.4rem 0.7rem;
    border: var(--bw) solid transparent;
    border-radius: 6px;
  }

  .links a:hover {
    color: var(--fg);
    text-decoration: none;
    border-color: var(--ink);
    background: var(--bg-raised);
  }

  .links a[aria-current='page'] {
    color: var(--fg);
    border-color: var(--ink);
    background: var(--bg-raised);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .links :global(#theme-toggle) {
    margin-left: 0.5rem;
  }

  /* Touch screens: 44px-tall targets. */
  @media (pointer: coarse) {
    .links a {
      padding-block: 0.7rem;
    }
  }

  @media (max-width: 520px) {
    .name {
      display: none;
    }

    .links a {
      padding-inline: 0.5rem;
    }
  }

  @media (max-width: 380px) {
    nav {
      gap: 0.5rem;
    }

    .links {
      gap: 0;
    }

    .links a {
      padding-inline: 0.4rem;
    }

    .links :global(#theme-toggle) {
      margin-left: 0.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark {
      transition: none;
    }
  }
</style>
