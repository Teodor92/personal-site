---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { site } from '../data/site';
import { slugify } from '../utils/slug';

interface Props {
  post: CollectionEntry<'blog'>;
  minutesRead?: string;
}

const { post, minutesRead } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

// Only worth showing when it lands on a different calendar day to publication.
const updatedOn =
  updatedDate && updatedDate.toDateString() !== pubDate.toDateString() ? updatedDate : undefined;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    ...(updatedDate && { dateModified: updatedDate.toISOString() }),
    ...(heroImage && { image: new URL(heroImage.src, site.url).toString() }),
    author: { '@type': 'Person', name: site.name, url: site.url },
    mainEntityOfPage: new URL(`/blog/${post.id}/`, site.url).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: new URL('/blog/', site.url).toString(),
      },
      { '@type': 'ListItem', position: 3, name: title },
    ],
  },
];
---

<Base
  title={`${title} | Teodor Kurtev`}
  description={description}
  image={`/og/blog/${post.id}.png`}
  article
  publishedTime={pubDate.toISOString()}
  updatedTime={updatedDate?.toISOString()}
  schema={schema}
>
  <div id="progress-bar" aria-hidden="true"></div>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {minutesRead && <span> · {minutesRead}</span>}
        {
          updatedOn && (
            <span>
              {' · '}Updated <time datetime={updatedOn.toISOString()}>{fmt(updatedOn)}</time>
            </span>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <ul class="tags fill-cycle">
            {tags.map((tag) => (
              <li>
                <a href={`/tags/${slugify(tag)}/`}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    <slot />
  </article>
</Base>

<style>
  article > header {
    margin-bottom: 2.5rem;
  }

  .meta {
    margin: 0.75rem 0 0;
  }

  .tags {
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags li a {
    text-decoration: none;
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--on-fill);
    background: var(--fill);
    border: 2px solid var(--ink);
    border-radius: 999px;
    box-shadow: 2px 2px 0 var(--ink);
    padding: 0.1rem 0.7rem;
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }

  .tags li a:hover {
    background: var(--fill);
    color: var(--on-fill);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--ink);
    text-decoration: none;
  }
</style>
