---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Card title heading level — pick so the page's heading order has no gaps. */
  headingLevel?: 'h2' | 'h3';
}

const { posts, headingLevel: Heading = 'h3' } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li data-reveal>
        <a class="card" href={`/blog/${post.id}/`}>
          <div class="meta">
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          </div>
          <Heading class="title">{post.data.title}</Heading>
          <p class="muted">{post.data.description}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .meta {
    font-size: var(--text-sm);
    color: var(--fg-faint);
    margin-bottom: 0.25rem;
  }

  .title {
    font-size: var(--text-lg);
    margin: 0 0 0.35rem;
  }

  p {
    margin: 0;
  }
</style>
