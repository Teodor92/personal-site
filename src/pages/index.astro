---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ContactActions from '../components/ContactActions.astro';
import CareerTrack from '../components/CareerTrack.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import Faceplate from '../components/Faceplate.astro';
import { site } from '../data/site';
import { personSchema } from '../data/schema';
// The hero's taped print uses a head-and-shoulders crop of the bio photo (the
// full 1536px original stays in public/ for the og:image and JSON-LD schema).
import avatar from '../assets/bio-photo-face.jpg';

const published = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Lead with the featured build, then the newest post from each pillar, so the
// homepage shows both halves of the work rather than whatever was posted last.
// Without curation it falls back to the three newest posts.
const featured = published.find((p) => p.data.featured);
const pillarPosts = (['ai', 'homelab'] as const)
  .map((pillar) => published.find((p) => p.data.pillar === pillar && p !== featured))
  .filter((p) => p !== undefined);
const posts = featured ? pillarPosts : published.slice(0, 3);

// The name is set as two stacked lines at display scale.
const nameLines = site.name.split(' ');
---

<Base
  title="Teodor Kurtev · Senior Applied AI Software Engineer"
  image="/og/index.png"
  schema={personSchema}
  home
>
  <section class="hero">
    <h1 class="name">
      {
        nameLines.map((line, i) => (
          <>
            {i > 0 && ' '}
            <span>{line}</span>
          </>
        ))
      }
    </h1>
    <figure class="print">
      <Image
        src={avatar}
        alt=""
        widths={[150, 260, 520]}
        sizes="(max-width: 640px) 7.5rem, 16rem"
        format="webp"
        loading="eager"
      />
      <figcaption class="data">{site.name}</figcaption>
    </figure>
    <div class="intro">
      <p class="role">{site.role}</p>
      <p class="pitch">{site.pitch}</p>
      <p class="proof">{site.proof}</p>
      <ContactActions>
        <SocialLinks exclude={['email']} />
      </ContactActions>
    </div>
  </section>

  <section>
    <Faceplate title="Career" href="/cv/" linkLabel="Full CV" />
    <CareerTrack />
  </section>

  {
    (featured || posts.length > 0) && (
      <section>
        <Faceplate title="Writing" href="/blog/" linkLabel="All posts" leds={['ai', 'lab']} />
        <div class="writing">
          {featured && <FeaturedPost post={featured} />}
          {posts.length > 0 && <PostList posts={posts} />}
        </div>
      </section>
    )
  }
</Base>

<style>
  /* Hero: the name at poster scale on the left, a taped print on the right. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    grid-template-areas:
      'name print'
      'intro print';
    column-gap: 3rem;
    align-items: start;
  }

  .name {
    grid-area: name;
    margin: 0;
    font-size: var(--text-hero);
    font-stretch: 75%;
    font-weight: 800;
    line-height: 0.84;
    letter-spacing: -0.04em;
    text-wrap: initial;
  }

  .name span {
    display: block;
  }

  /* The photo as a print taped to the page. */
  .print {
    grid-area: print;
    position: relative;
    margin: 0.75rem 0 0;
    padding: 0.7rem 0.7rem 0.6rem;
    background: #ffffff;
    border: var(--bw) solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    transform: rotate(2.5deg);
  }

  .print::before {
    content: '';
    position: absolute;
    top: -0.9rem;
    left: 50%;
    width: 6.5rem;
    height: 1.7rem;
    translate: -50% 0;
    rotate: -4deg;
    /* Masking tape: a fixed translucent paper tone, so it reads as tape on the
       white print in both themes. */
    background: rgb(240 230 196 / 0.82);
    border: 1px solid rgb(18 17 16 / 0.18);
  }

  .print figcaption {
    margin-top: 0.55rem;
    font-size: 0.72rem;
    color: #3b3830;
    letter-spacing: 0.02em;
  }

  .print img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 2px solid #121110;
    border-radius: 0;
  }

  .intro {
    grid-area: intro;
    margin-top: 1.25rem;
  }

  /* Role sticker in the AI colour: the role is the applied AI one. */
  .role {
    display: inline-block;
    background: var(--ai);
    color: var(--on-fill);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-base);
    border: var(--bw) solid var(--ink);
    border-radius: 6px;
    box-shadow: 4px 4px 0 var(--ink);
    padding: 0.25rem 0.75rem;
    margin: 0 0 1.4rem;
    transform: rotate(-1.2deg);
  }

  .pitch {
    color: var(--fg);
    font-size: var(--text-lg);
    line-height: 1.6;
    max-width: 36rem;
    margin-bottom: 0.75rem;
  }

  .proof {
    color: var(--fg-muted);
    max-width: 36rem;
    margin-bottom: 1.6rem;
  }

  /* Distinct sections sit far apart; a plate hugs its own content. */
  section + section {
    margin-top: 4rem;
  }

  .writing {
    display: grid;
    gap: 1.6rem;
    container-type: inline-size;
  }

  /* The two pillar cards sit side by side under the featured post when there's room. */
  @container (width > 36rem) {
    .writing :global(.post-list) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .writing :global(.post-list > li) {
      display: grid;
    }
  }

  @media (max-width: 640px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 7.5rem;
      grid-template-areas:
        'name print'
        'intro intro';
      column-gap: 1rem;
      padding-top: 0;
    }

    .print {
      margin-top: 0.3rem;
      padding: 0.4rem 0.4rem 0.35rem;
      box-shadow: 5px 5px 0 var(--ink);
    }

    .print figcaption {
      margin-top: 0.3rem;
      font-size: 0.6rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: clip;
    }

    .print::before {
      width: 4rem;
      height: 1.1rem;
      top: -0.6rem;
    }
  }
</style>
