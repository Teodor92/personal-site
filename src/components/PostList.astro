---
import type { CollectionEntry } from 'astro:content';
import { pillarLabels } from '../data/pillars';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Card title heading level; pick so the page's heading order has no gaps. */
  headingLevel?: 'h2' | 'h3';
}

const { posts, headingLevel: Heading = 'h3' } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<ul class="post-list fill-cycle">
  {
    posts.map((post) => (
      <li>
        <a class="card" href={`/blog/${post.id}/`}>
          <Heading class="title">{post.data.title}</Heading>
          <div class="meta">
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            {post.data.pillar && <span class="pillar">{pillarLabels[post.data.pillar]}</span>}
          </div>
          <p class="muted">{post.data.description}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.4rem;
  }

  /* Pretty, not balanced: balance squeezed long titles into ~60% of the card. */
  .title {
    font-size: var(--text-lg);
    margin: 0 0 0.2rem;
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.6rem;
    margin-bottom: 0.35rem;
  }

  /* Pillar sticker, after the date (never as an eyebrow over the title). */
  .pillar {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.35;
    padding: 0 0.35rem;
    border: 2px solid currentColor;
    border-radius: 4px;
  }

  p {
    margin: 0;
  }
</style>
