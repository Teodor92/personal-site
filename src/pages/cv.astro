---
import Base from '../layouts/Base.astro';
import { roles, education, skills, volunteering, interests } from '../data/cv';
import { site } from '../data/site';
import { personSchema } from '../data/schema';
import { cvFileBase } from '../data/cv-filename.mjs';
---

<Base title="CV | Teodor Kurtev" wide image="/og/cv.png" schema={personSchema}>
  <div class="cv-top">
    <div>
      <h1>Curriculum Vitae</h1>
      <p class="muted contact">
        {site.name} · Senior AI Software Engineer · <a href={`mailto:${site.email}`}>{site.email}</a
        >
      </p>
    </div>
    <div class="downloads">
      <a href={`/${cvFileBase}.pdf`}>Download PDF</a>
      <a href={`/${cvFileBase}.docx`}>Download DOCX</a>
    </div>
  </div>

  <h2>Experience</h2>
  <div class="timeline">
    {
      roles.slice(0, 4).map((role) => (
        <article data-reveal>
          <header>
            <h3>
              {role.title} · <a href={role.url}>{role.company}</a>
            </h3>
            <p class="muted">
              {role.period}
              {role.location && ` · ${role.location}`}
            </p>
          </header>
          {role.intro && <p class="intro">{role.intro}</p>}
          <ul>
            {role.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </article>
      ))
    }
    {
      roles.slice(4).map((role) => (
        <article data-reveal>
          <details>
            <summary>
              <h3>
                {role.title} · <span class="company">{role.company}</span>
              </h3>
              <p class="muted">
                {role.period}
                {role.location && ` · ${role.location}`}
              </p>
            </summary>
            <p class="muted org-link">
              <a href={role.url}>{role.company} ↗</a>
            </p>
            {role.intro && <p class="intro">{role.intro}</p>}
            <ul>
              {role.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </details>
        </article>
      ))
    }
  </div>

  <h2>Education</h2>
  <div class="timeline">
    {
      education.map((e) => (
        <article>
          <header>
            <h3>
              {e.degree} · <a href={e.url}>{e.school}</a>
            </h3>
            <p class="muted">
              {e.location} · {e.note}
            </p>
          </header>
          <p>{e.details}</p>
        </article>
      ))
    }
  </div>

  <h2>Skills</h2>
  <dl class="skills">
    {
      skills.map((s) => (
        <>
          <dt>{s.group}</dt>
          <dd class="muted">{s.items}</dd>
        </>
      ))
    }
  </dl>

  <h2>Volunteering</h2>
  <div class="timeline">
    {
      volunteering.map((v) => (
        <article>
          <header>
            <h3>
              {v.role} · <a href={v.url}>{v.org}</a>
            </h3>
          </header>
          <p>{v.details}</p>
        </article>
      ))
    }
  </div>

  <h2>Interests</h2>
  <p>{interests.join(' · ')}</p>
</Base>

<script>
  // Closed <details> content doesn't print. Open everything when the reader hits
  // ⌘P and restore afterwards. (The downloadable PDF is generated separately at build time —
  // Chromium's print-to-PDF doesn't fire these events, so that script opens the
  // details itself; see scripts/generate-cv-pdf.mjs.)
  let touched: HTMLDetailsElement[] = [];

  function openAll() {
    touched = [...document.querySelectorAll<HTMLDetailsElement>('details:not([open])')];
    touched.forEach((d) => (d.open = true));
  }

  function restore() {
    touched.forEach((d) => (d.open = false));
    touched = [];
  }

  window.addEventListener('beforeprint', openAll);
  window.addEventListener('afterprint', restore);
</script>

<style>
  .cv-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .contact {
    margin-top: 0.4rem;
  }

  /* Wraps so the two links stay together when .cv-top breaks onto two rows. */
  .downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Styled as the button they replaced; they point at the build-time artifacts. */
  .downloads a {
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    padding: 0.45rem 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .downloads a:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  @media print {
    .downloads {
      display: none;
    }

    .timeline {
      border-left-width: 1px;
      gap: 1.2rem;
    }
  }

  .timeline {
    display: grid;
    gap: 2rem;
    border-left: 2px solid var(--border);
    padding-left: 1.5rem;
  }

  .timeline article {
    position: relative;
  }

  .timeline article::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 6px);
    top: 0.5em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }

  .timeline h3 {
    margin: 0;
  }

  .timeline header p {
    margin: 0.15rem 0 0.6rem;
  }

  .intro {
    margin-bottom: 0.6rem;
  }

  .timeline ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .timeline li + li {
    margin-top: 0.3rem;
  }

  details summary {
    cursor: pointer;
    list-style: none;
  }

  details summary::-webkit-details-marker {
    display: none;
  }

  details summary h3 {
    display: inline;
  }

  details summary h3::after {
    content: ' +';
    color: var(--fg-faint);
  }

  details[open] summary h3::after {
    content: ' –';
  }

  details summary:hover h3 {
    color: var(--accent);
  }

  .org-link {
    margin: 0.4rem 0;
  }

  .skills dt {
    font-weight: 600;
    margin-top: 1rem;
  }

  .skills dd {
    margin: 0.2rem 0 0;
  }
</style>
