---
// Layout for plain markdown pages (uses.md, now.md).
import Base from './Base.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
// OG cards are generated per page in src/pages/og/[...route].ts, keyed by
// the lowercased title ('uses', 'now').
const ogImage = `/og/${frontmatter.title.toLowerCase()}.png`;
---

<Base
  title={`${frontmatter.title} | Teodor Kurtev`}
  description={frontmatter.description}
  image={ogImage}
>
  <h1>{frontmatter.title}</h1>
  <slot />
</Base>
