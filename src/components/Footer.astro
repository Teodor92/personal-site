---
import SocialLinks from './SocialLinks.astro';
import ContactActions from './ContactActions.astro';
import { site } from '../data/site';

interface Props {
  size?: 'content' | 'wide' | 'home'; // match <main>'s width, as the header does
}

const { size = 'content' } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <div class:list={['inner', size]}>
    <div class="ask">
      <p class="ask-line">
        Working on something in <mark>applied AI</mark>? I'd like to hear about it.
      </p>
      <ContactActions />
    </div>
    <div class="base">
      <small>
        © {year} {site.name} · <a href="/feed.xml">RSS</a>
      </small>
      <SocialLinks exclude={['email']} />
    </div>
  </div>
</footer>

<style>
  /* The page closes on a dark slab in both themes. Tokens are re-set locally
     so the shared buttons and links invert without footer-specific copies. */
  footer {
    --bg: #121110;
    --bg-raised: #211f19;
    --fg: #fffbea;
    --fg-muted: #cfc9b4;
    --ink: #fffbea;
    --accent: #fffbea;
    --accent-hover: #fffbea;

    background: var(--bg);
    color: var(--fg);
    border-top: var(--bw) solid #121110;
    margin-top: auto;
  }

  /* Dark: the closing slab is raised above the dark page, not sunk into it. */
  :global([data-theme='dark']) footer {
    --bg: #29261e;
    --bg-raised: #34302a;
    background: var(--bg);
    border-top-color: #f4efdc;
  }

  .inner {
    width: min(100% - 2.5rem, var(--content-width));
    margin-inline: auto;
    padding-block: 3rem 1.75rem;
    display: grid;
    gap: 2.5rem;
  }

  .inner.wide {
    width: min(100% - 2.5rem, var(--wide-width));
  }

  .inner.home {
    width: min(100% - 2.5rem, var(--home-width));
  }

  .ask {
    display: grid;
    gap: 1.25rem;
  }

  .ask-line {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    font-stretch: 88%;
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 22ch;
    text-wrap: balance;
    margin: 0;
  }

  mark {
    background: var(--ai);
    color: var(--on-fill);
    padding: 0 0.15em;
    box-decoration-break: clone;
  }

  .base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }

  small {
    color: var(--fg-muted);
  }
</style>
