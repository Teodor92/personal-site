---
// Cycles the theme preference light → dark → system and persists it.
// Click handling is delegated in Base.astro (survives view transitions); the
// preference and resolved theme come from the inline head script there, which
// sets [data-theme-pref] on <html>. The icon and the accessible name are both
// picked by CSS from that attribute, so nothing here needs re-binding.
---

<button id="theme-toggle" class="brutal-btn" type="button">
  <svg
    class="icon light"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
    ></path>
  </svg>
  <svg
    class="icon dark"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path>
  </svg>
  <svg
    class="icon system"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="3" y="4" width="18" height="12" rx="2"></rect>
    <path d="M8 20h8m-4-4v4"></path>
  </svg>
  <!-- Only the span matching the current preference is displayed, so it alone
       becomes the button's accessible name. -->
  <span class="visually-hidden label light">Theme: light. Switch to dark</span>
  <span class="visually-hidden label dark">Theme: dark. Switch to system</span>
  <span class="visually-hidden label system">Theme: system. Switch to light</span>
</button>

<style>
  button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    background: var(--cyan);
    color: var(--on-fill);
    cursor: pointer;
  }

  button:hover {
    background: var(--pink);
  }

  .icon {
    position: absolute;
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
    transition:
      transform 0.35s ease,
      opacity 0.25s ease;
  }

  .label {
    display: none;
  }

  /* No JS (or before the head script runs): fall back to the system state. */
  :global(html:not([data-theme-pref])) .system,
  :global([data-theme-pref='light']) .light,
  :global([data-theme-pref='dark']) .dark,
  :global([data-theme-pref='system']) .system {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  :global(html:not([data-theme-pref])) .label.system,
  :global([data-theme-pref='light']) .label.light,
  :global([data-theme-pref='dark']) .label.dark,
  :global([data-theme-pref='system']) .label.system {
    display: inline;
  }

  @media (prefers-reduced-motion: reduce) {
    button,
    .icon {
      transition: none;
    }
  }
</style>
