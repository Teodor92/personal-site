---
import type { CollectionEntry } from 'astro:content';
import { pillarLabels } from '../data/pillars';
import { postResults } from '../data/post-results';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Card title heading level; pick so the page's heading order has no gaps. */
  headingLevel?: 'h2' | 'h3';
}

const { posts, headingLevel: Heading = 'h3' } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<ul class="post-list">
  {posts.map((post) => (
    <li
      class:list={{
        'is-ai': post.data.pillar === 'ai',
        'is-lab': post.data.pillar === 'homelab',
      }}
    >
      <a class="card" href={`/blog/${post.id}/`}>
        <Heading class="title">{post.data.title}</Heading>
        <div class="meta">
          <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          {post.data.pillar && (
            <span class:list={['pillar', post.data.pillar]}>{pillarLabels[post.data.pillar]}</span>
          )}
        </div>
        <p class="muted">{post.data.description}</p>
        {postResults[post.id] && (
          <p class="result">
            <span class="data figure">{postResults[post.id].figure}</span>{' '}
            {postResults[post.id].label}
          </p>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.4rem;
  }

  /* Pretty, not balanced: balance squeezed long titles into ~60% of the card. */
  .title {
    font-size: var(--text-lg);
    margin: 0 0 0.2rem;
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.6rem;
    margin-bottom: 0.35rem;
  }

  p {
    margin: 0;
  }

  /* The post's measured result, set inline on a dashed rule: proof, not a stat block. */
  .result {
    margin-top: 0.85rem;
    padding-top: 0.65rem;
    border-top: 2px dashed var(--ink);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .figure {
    font-weight: 700;
    color: var(--fg);
    margin-right: 0.15rem;
  }
</style>
