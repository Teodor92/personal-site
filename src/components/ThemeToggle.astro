---
// Flips [data-theme] on <html> and persists the choice.
// Click handling is delegated in Base.astro (survives view transitions);
// initial theme comes from the inline head script there.
---

<button id="theme-toggle" type="button" aria-label="Toggle dark mode">
  <svg
    class="sun"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
    ></path>
  </svg>
  <svg
    class="moon"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path>
  </svg>
</button>

<style>
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      transform 0.25s ease;
  }

  button:hover {
    color: var(--fg);
    border-color: var(--fg-faint);
  }

  button:active {
    transform: rotate(40deg) scale(0.9);
  }

  svg {
    transition:
      transform 0.35s ease,
      opacity 0.25s ease;
  }

  .moon {
    position: absolute;
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  :global([data-theme='dark']) .sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  :global([data-theme='dark']) .moon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    button,
    svg {
      transition: none;
    }
  }
</style>
