---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../data/site';
import { roles } from '../data/cv';
import { personSchema } from '../data/schema';
// Rendered at 96px; astro:assets emits webp at 1x/2x instead of the 1536px
// original (which stays in public/ for the og:image and JSON-LD Person schema).
import avatar from '../assets/bio-photo.jpg';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const highlights = roles.filter((r) => r.highlight);
---

<Base
  title="Teodor Kurtev · Senior Applied AI Software Engineer"
  image="/og/index.png"
  schema={personSchema}
>
  <section class="hero">
    <Image
      src={avatar}
      alt={site.name}
      width={96}
      height={96}
      densities={[1, 2]}
      format="webp"
      loading="eager"
    />
    <div>
      <h1>{site.name}</h1>
      <p class="role">{site.role}</p>
      <p class="pitch">{site.pitch}</p>
      <SocialLinks />
    </div>
  </section>

  <section>
    <h2>Recent roles</h2>
    <ul class="highlights">
      {
        highlights.map((r) => (
          <li>
            <strong>
              {r.title} · <a href={r.url}>{r.company}</a>
            </strong>
            <span class="meta"> · {r.period}</span>
            <p class="muted">{r.bullets[0]}</p>
          </li>
        ))
      }
    </ul>
    <p><a href="/cv/">Full CV →</a></p>
  </section>

  <section>
    <h2>Recent writing</h2>
    <PostList posts={posts} />
    <p class="all-posts"><a href="/blog/">All posts →</a></p>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
    margin-bottom: 3.5rem;
  }

  /* Gradient ring: the padding lets the background show around the photo. */
  .hero img {
    border-radius: 50%;
    flex-shrink: 0;
    padding: 3px;
    background: var(--gradient);
    box-shadow: var(--shadow-accent);
  }

  .hero h1 {
    margin-bottom: 0.15rem;
  }

  /* Gradient name; both ends are AA against --bg in each theme. Plain --fg
     where background-clip: text is unsupported. */
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .hero h1 {
      background: var(--gradient-text);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      width: fit-content;
    }
  }

  .role {
    color: var(--accent);
    font-weight: 550;
    margin-bottom: 0.75rem;
  }

  .pitch {
    color: var(--fg-muted);
    max-width: 36rem;
  }

  section + section {
    margin-top: 3rem;
  }

  section h2 {
    font-size: var(--text-lg);
    margin-top: 0;
    margin-bottom: 1rem;
  }

  /* Short gradient bar under each section heading. */
  section h2::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 3px;
    margin-top: 0.4rem;
    border-radius: 999px;
    background: var(--gradient);
  }

  .highlights {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }

  .highlights p {
    margin: 0.2rem 0 0;
  }

  .all-posts {
    margin-top: 1.25rem;
  }

  /* The gradient is a transparent-text trick; print it as plain ink. */
  @media print {
    .hero h1 {
      background: none;
      color: var(--fg);
    }
  }

  @media (max-width: 540px) {
    .hero {
      flex-direction: column;
      gap: 1.25rem;
    }
  }
</style>
