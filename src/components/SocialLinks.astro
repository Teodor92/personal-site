---

<ul class="socials">
  {
    site.socials.map(({ label, url, icon }) => (
      <li>
        <a href={url} aria-label={label} title={label} rel="me noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={icons[icon]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: flex;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg-muted);
  }

  .socials a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
